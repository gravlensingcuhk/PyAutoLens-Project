# HTCondor submit file: the SINGLE no-subhalo baseline fit.
#
# Run this first:
#   condor_submit submission_subhalo_baseline.sub
#
# It fits the mass model without a DM subhalo ONCE. The 16 tile jobs below all
# load this same result as their evidence reference, so the delta-log-evidence
# map is computed against a common baseline (not 16 slightly different ones).

universe = vanilla
getenv = True
executable = /users/wing-yan.chan/PyAutoLens-Project/proposed_subhalo/run_job_subhalo_baseline.sh
initialdir = /users/wing-yan.chan/PyAutoLens-Project/proposed_subhalo/

# EDIT these to match the target:
#   $1 dataset   -> dataset name under data/cowls/
#   $2 filter    -> F444W / F277W / F150W / F115W
#   $3 source prefix -> path_prefix of the finished source_pix[1] result
#   $4 mass prefix   -> path_prefix of the finished mass_EPL result
arguments = "COSJ100024+021749 F444W model_setup_free_source mass_models"

output = /users/wing-yan.chan/log_files/subhalo_baseline.out
error  = /users/wing-yan.chan/log_files/subhalo_baseline.err
log    = /users/wing-yan.chan/log_files/subhalo_baseline.log

request_cpus = 16
request_memory = 128GB
request_disk = 2GB

queue
